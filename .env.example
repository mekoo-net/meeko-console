# 复制为 .env.development 或 .env.local 后重启 pnpm dev

# Mock 本地演示（不依赖 Gateway）
# VITE_USE_MOCK=true

# 联调 Meeko 平台 Gateway（/api、/auth、/demux 等控制面）
VITE_USE_MOCK=false
VITE_API_BASE=https://api.meeko.top

# Demux.Gateway 业务 API（速率限制、sk- 令牌等；路径 /api/*）
VITE_DEMUX_API_BASE=https://console.meeyo.org

# 本地 AppHost：VITE_API_BASE=http://localhost:7000
# 本地 Demux.Gateway Api：VITE_DEMUX_API_BASE=http://localhost:8201
