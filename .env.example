# 复制为 .env.development 或 .env.local 后重启 pnpm dev

# Mock 本地演示（不依赖 Gateway）
# VITE_USE_MOCK=true

# 联调 Meeko 平台 Gateway（/api、/auth、/yomi 等控制面）
VITE_USE_MOCK=false
VITE_API_BASE=https://api.meeko.top

# Yomi.Gateway 业务 API（速率限制、sk- 令牌等；路径 /api/*）
VITE_YOMI_API_BASE=https://api.meeyo.org

# 本地 AppHost：VITE_API_BASE=http://localhost:7000
# 本地 Yomi.Gateway：VITE_YOMI_API_BASE=http://localhost:80
