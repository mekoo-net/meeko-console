{
  "name": "meeko-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "dayjs": "1.11.20",
    "element-plus": "2.14.0",
    "nanoid": "5.1.11",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-router": "5.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/coverage-v8": "4.1.5",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.10",
    "eslint": "10.3.0",
    "eslint-plugin-vue": "10.9.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "vite": "8.0.12",
    "vitest": "4.1.5",
    "vue-tsc": "3.2.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
